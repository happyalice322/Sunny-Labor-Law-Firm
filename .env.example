# ==============================================================================
# 노동법률사무소 맑은 환경 변수 예시 템플릿 (.env.example)
# 실제 API Key 및 토큰은 이 템플릿을 복사하여 생성한 .env 파일에 작성하세요.
# .env 파일은 .gitignore에 등록되어 저장소에 업로드되지 않습니다.
# ==============================================================================

# GEMINI_API_KEY: Gemini AI API calls (Optional / Server)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="YOUR_APP_URL"

# Formspree Contact Form Integration
# 상담 문의 이메일 수신을 위한 Formspree Form ID 또는 전체 엔드포인트 URL
VITE_FORMSPREE_FORM_ID="YOUR_FORMSPREE_FORM_ID"
VITE_FORMSPREE_ENDPOINT="https://formspree.io/f/YOUR_FORMSPREE_FORM_ID"
